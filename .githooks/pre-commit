#!/usr/bin/env sh
# pre-commit hook: keep docs/INDEX.md in sync and run the doc checks.
# Enabled automatically by `npm install` (see the "prepare" script in package.json).
# Runs under Git Bash on Windows. Fails the commit if `npm run check` finds errors.

echo "[pre-commit] regenerating docs/INDEX.md ..."
npm run map --silent 2>/dev/null || echo "[pre-commit] npm run map failed, continuing"

if ! git diff --quiet -- docs/INDEX.md; then
  git add docs/INDEX.md
  echo "[pre-commit] docs/INDEX.md updated and staged"
fi

echo "[pre-commit] running npm run check ..."
if ! npm run check --silent; then
  echo "[pre-commit] BLOCKED: npm run check reported errors. Fix them and commit again."
  exit 1
fi

echo "[pre-commit] ok"
exit 0